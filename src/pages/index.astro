---
import AdSlot from "../components/AdSlot.astro";
import Finder from "../components/Finder.astro";
import TractorGag from "../components/TractorGag.astro";
import Base from "../layouts/Base.astro";
import { siteConfig } from "../site";
import { loadCatalog } from "../../scripts/catalog.mjs";

const catalog = loadCatalog();
const wanted = ["1025r", "1023e", "l3902", "bx2380", "l2502", "ck2640", "gc1723e", "workmaster-25s", "sa221", "t264", "ct1025", "b2601hsd"];
const popular = wanted
  .map((slug) => catalog.models.find((model) => model.slug === slug))
  .filter(Boolean);
const field = (model, key) => model.fields.find((item) => item.key === key)?.value || "—";
const description = "Look up published PTO horsepower, hitch category, and lift for a compact tractor, then check an implement range.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteConfig.name,
  url: siteConfig.url,
  email: siteConfig.contactEmail,
  contactPoint: { "@type": "ContactPoint", email: siteConfig.contactEmail, contactType: "editorial" },
};
---
<Base title="What fits your compact tractor" description={description} jsonLd={jsonLd}>
  <div class="hero">
    <div class="wrap hero-in">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1>What fits your compact tractor</h1>
          <p class="lede">Pick the brand and the model. You get the published PTO horsepower, hitch category, and lift. Add an attachment only if its maker printed a horsepower range.</p>
          <TractorGag />
        </div>
        <Finder />
      </div>
    </div>
  </div>
  <div class="band">
    <div class="wrap">
      <section>
        <h2>Horsepower alone does not pick the implement</h2>
        <p>Engine horsepower on the hood is not PTO horsepower. Gear and hydrostatic transmissions often print two PTO figures. A hitch printed as Limited Category 1 is not Category 1. Rear lift counts only at the measurement point named on the sheet. Weight is the published weight, not a ballast recipe.</p>
        <p>The fit check says “inside the published range” or “cannot tell.” It does not say an implement is approved. Read <a href="/sizing/limited-category-1/">Limited Category 1</a>, <a href="/sizing/gear-vs-hst-pto/">gear versus HST PTO</a>, and <a href="/sizing/loader-vs-fork/">loader lift versus forks</a>.</p>
      </section>
      <section>
        <h2>Often looked up</h2>
        <table class="dense">
          <thead>
            <tr><th>Model</th><th>PTO</th><th>Hitch</th></tr>
          </thead>
          <tbody>
            {popular.map((model) => (
              <tr>
                <td><a href={model.path}>{model.brand} {model.name}</a></td>
                <td class="mono">{field(model, "pto_hp")}</td>
                <td class="mono">{field(model, "hitch")}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
      <section>
        <h2>By brand</h2>
        <ul class="chips">
          {catalog.brands.map((brand) => (
            <li><a href={brand.path}>{brand.name}</a></li>
          ))}
        </ul>
      </section>
      <AdSlot />
    </div>
  </div>
</Base>
