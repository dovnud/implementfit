---
import SpecTable from "../../components/SpecTable.astro";
import Base from "../../layouts/Base.astro";
import { loadCatalog } from "../../../scripts/catalog.mjs";

export function getStaticPaths() {
  return loadCatalog().comparisons.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}
const { page } = Astro.props;
---
<Base
  title={page.title}
  description={page.note}
  crumbs={[{ name: "Home", href: "/" }, { name: "Compare", href: "/compare/" }, { name: page.title, href: page.path }]}
>
  <h1>{page.title}</h1>
  <p class="lede">{page.note}</p>
  <p class="note">
    {page.kind === "single"
      ? `${page.models[0].brand} ${page.models[0].name} is one column in the source table. Gear and hydrostatic figures are inside that column, not two invented tractors.`
      : `Each column is a separate verified model page. Numbers are not subtracted into a new rating.`}
  </p>
  <div class="grid">
    {page.models.map((model) => (
      <article class="card">
        <h2><a href={model.path}>{model.brand} {model.name}</a></h2>
        <SpecTable fields={model.fields} />
        <p class="source"><a href={model.sourceUrl}>{model.sourceTitle}</a>. Checked {model.checked}.</p>
      </article>
    ))}
  </div>
  <div class="safety">
    <p>Lift figures in these columns keep the measurement point from each source. Do not treat the higher number as the one to use for forks or ballast.</p>
  </div>
</Base>
