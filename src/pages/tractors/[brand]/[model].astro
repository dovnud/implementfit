---
import AdSlot from "../../../components/AdSlot.astro";
import SpecTable from "../../../components/SpecTable.astro";
import Base from "../../../layouts/Base.astro";
import { siteConfig } from "../../../site";
import { loadCatalog } from "../../../../scripts/catalog.mjs";

export function getStaticPaths() {
  return loadCatalog().models.map((model) => ({
    params: { brand: model.brandSlug, model: model.slug },
    props: { model },
  }));
}

const { model } = Astro.props;
const catalog = loadCatalog();
const seriesMates = catalog.models.filter(
  (item) => item.brandSlug === model.brandSlug && item.series === model.series && item.slug !== model.slug,
);
const comparisons = catalog.comparisons.filter((page) =>
  page.models.some((item) => item.brandSlug === model.brandSlug && item.slug === model.slug),
);
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Tractors", href: "/tractors/" },
  { name: model.brand, href: `/brands/${model.brandSlug}/` },
  { name: model.name, href: model.path },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: `${model.brand} ${model.name}`,
  brand: { "@type": "Brand", name: model.brand },
  description: model.note.slice(0, 280),
  additionalProperty: model.fields
    .filter((field) => !field.conflict)
    .map((field) => ({
      "@type": "PropertyValue",
      name: field.label,
      value: field.value,
      unitText: field.note || undefined,
    })),
};
const description = `${model.brand} ${model.name}: verified PTO, hitch, and lift figures from ${model.sourceTitle}, checked ${model.checked}.`;
---
<Base title={`${model.brand} ${model.name}`} description={description} crumbs={crumbs} jsonLd={jsonLd}>
  <h1>{model.brand} {model.name}</h1>
  <p class="source">{model.series}. Checked {model.checked}.</p>
  <section class="sheet" aria-label="Spec sheet">
    <SpecTable fields={model.fields} />
    <p class="source">Source: <a href={model.sourceUrl}>{model.sourceTitle}</a>.</p>
  </section>
  <p class="note">{model.note}</p>
  <div class="callout" data-template>
    <p>Lift and loader numbers are the published figure at the stated point. They are not fork capacity and not a ballast weight. Check the manual for your serial before you mount anything.</p>
  </div>
  <h2>What fits</h2>
  <p>Run this tractor in the <a href="/fit/">fit check</a>. The result is “inside the published range” or “cannot tell.”</p>
  <ul>
    <li><a href="/sizing/limited-category-1/">Limited Category 1</a></li>
    <li><a href="/sizing/gear-vs-hst-pto/">Gear and HST PTO</a></li>
    <li><a href="/sizing/loader-vs-fork/">Loader lift and forks</a></li>
    <li><a href="/attachments/rotary-cutter/">Rotary cutters</a></li>
    <li><a href={`/brands/${model.brandSlug}/`}>{model.brand}</a></li>
    {comparisons.map((page) => <li><a href={page.path}>{page.title}</a></li>)}
  </ul>
  <h2>Maintenance</h2>
  {model.maintenancePath ? (
    <p><a href={model.maintenancePath}>Filters and fluids for the {model.name}</a>. A part number is here only when an OEM document printed it.</p>
  ) : model.maintenance.length > 0 ? (
    <>
      <p>Published fluids. No verified filter part number, so there is no separate maintenance page.</p>
      <table class="specs">
        <tbody>
          {model.maintenance.map((item) => (
            <tr class={item.conflict ? "conflict" : undefined}>
              <th scope="row">{item.label}</th>
              <td>
                <p>{item.value}</p>
                {item.detail && <p>{item.detail}</p>}
                <p class="source"><a href={item.sourceUrl}>{item.sourceTitle}</a>. Checked {item.checked}.</p>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  ) : (
    <p>No verified filter number or fluid capacity is stored for the {model.name}.</p>
  )}
  <h2>Sources</h2>
  <p class="source"><a href={model.sourceUrl}>{model.sourceTitle}</a>. Checked {model.checked}. The full list is on <a href="/sources/">Sources</a>. Disagreements are on <a href="/corrections/">Corrections</a>.</p>
  {seriesMates.length > 0 && (
    <>
      <h2>Same series</h2>
      <ul>
        {seriesMates.map((item) => (
          <li><a href={item.path}>{item.name}</a></li>
        ))}
      </ul>
    </>
  )}
  <AdSlot />
</Base>
