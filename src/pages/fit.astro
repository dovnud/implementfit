---
import Finder from "../components/Finder.astro";
import Base from "../layouts/Base.astro";
---
<Base
  title="Fit check"
  description="Compare a published tractor PTO and hitch with a maker’s horsepower range."
  crumbs={[{ name: "Home", href: "/" }, { name: "Fit check", href: "/fit/" }]}
>
  <h1>Fit check</h1>
  <p class="lede">Same finder as the home page. The words you can get back are “inside the published range” and “cannot tell.”</p>
  <Finder />
  <div class="callout" data-template>
    <p>Lift is not part of this check. The attachment rows do not share a lift measurement point with the tractors. This tool does not calculate ballast.</p>
  </div>
</Base>
