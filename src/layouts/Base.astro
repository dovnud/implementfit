---
import "../styles/global.css";
import { isPreviewBuild, siteConfig } from "../site";

interface Crumb { name: string; href: string }
interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, crumbs = [], jsonLd, noindex = false } = Astro.props;
const preview = isPreviewBuild();
const canonical = new URL(Astro.url.pathname, siteConfig.url).href;
const breadcrumbLd = crumbs.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.name,
        item: new URL(crumb.href, siteConfig.url).href,
      })),
    }
  : null;
const blocks = [breadcrumbLd, jsonLd].flat().filter(Boolean);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    {!preview && noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {blocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href="/">{siteConfig.name}</a>
        <nav aria-label="Primary">
          <ul>
            <li><a href="/tractors/">Tractors</a></li>
            <li><a href="/brands/">Brands</a></li>
            <li><a href="/attachments/">Attachments</a></li>
            <li><a href="/compare/">Compare</a></li>
            <li><a href="/sizing/">Sizing</a></li>
            <li><a href="/fit/">Fit check</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="content" class="wrap">
      {crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            {crumbs.map((crumb, index) => (
              <li>
                {index < crumbs.length - 1 ? <a href={crumb.href}>{crumb.name}</a> : <span aria-current="page">{crumb.name}</span>}
                {index < crumbs.length - 1 && <span aria-hidden="true"> / </span>}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>
          Published by {siteConfig.editorialName}. Contact
          <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>.
          Specs are quoted from the linked documents. This site does not publish a fit verdict or a ballast weight.
        </p>
        <p>
          <a href="/about/">About</a> ·
          <a href="/methodology/">Methodology</a> ·
          <a href="/sources/">Sources</a> ·
          <a href="/corrections/">Corrections</a> ·
          <a href="/privacy/">Privacy</a> ·
          <a href="/terms/">Terms</a> ·
          <a href="/disclosure/">Affiliate disclosure</a> ·
          <a href="/contact/">Contact</a>
        </p>
      </div>
    </footer>
  </body>
</html>
